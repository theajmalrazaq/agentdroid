# Silent AI Agent Android System Properties for Redroid
# Enables root ADB without confirmation prompts, disables setup wizards, and silences audio.

ro.secure=0
ro.adb.secure=0
ro.debuggable=1
persist.sys.usb.config=adb
service.adb.tcp.port=5555

# Disable first-run setup wizard & provisioning screens
ro.setupwizard.mode=DISABLED
ro.com.google.gmsversion=

# Silence default audio streams
ro.config.media_vol_default=0
ro.config.vc_call_vol_default=0
ro.config.alarm_alert=
ro.config.notification_sound=
ro.config.ringtone=
ro.audio.silent=1

# Disable crash/ANR dialogs blocking UI automation
persist.sys.disable_rescue=true
