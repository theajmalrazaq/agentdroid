# Local AgentDroid (MCP / CLI / compound workflows) needs NO cloud API keys.
#
# Redroid container defaults (aligned with the benchmarked Android 11 x86_64 image).
# Override REDROID_IMAGE (e.g. redroid/redroid:16.0.0_64only-latest) if you want a newer Android build.
REDROID_IMAGE=redroid/redroid:11.0.0-latest
REDROID_ADB_PORT=5555
REDROID_WIDTH=1080
REDROID_HEIGHT=2400
REDROID_DPI=440
REDROID_FPS=60
REDROID_GPU_MODE=guest
REDROID_DNS=1.1.1.1

# Optional security hardening (also settable per command via --safe / --shell-allowlist)
# AGENTDROID_SAFE_MODE=1
# AGENTDROID_SHELL_ALLOWLIST=pm list packages,dumpsys window

# Optional cloud integration: ONLY required if you run `agentdroid ai` (calls https://api.typesafe.ai)
# TYPESAFE_API_KEY=
