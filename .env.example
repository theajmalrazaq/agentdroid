# ==============================================================================
# AgentRedroid × Artemis Configuration (.env)
# ==============================================================================
# Copy this file to .env and configure at least one LLM API key for Artemis:
#   cp .env.example .env

# --- LLM Provider Credentials (at least one required for AI goals) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ROUTER_API_KEY=
XAI_API_KEY=

# --- Redroid Silent Android Device Settings ---
REDROID_IMAGE=redroid/redroid:16.0.0_64only-latest
REDROID_ADB_PORT=5555
REDROID_WIDTH=1080
REDROID_HEIGHT=2400
REDROID_DPI=440
REDROID_FPS=60
# GPU rendering mode: 'guest' (software, works everywhere), 'host' (GPU accelerated), or 'auto'
REDROID_GPU_MODE=guest
REDROID_USE_MEMFD=true

# --- Artemis Agent Controller Settings ---
ARTEMIS_PORT=8000
ARTEMIS_BASE_URL=http://127.0.0.1:8000
# Execution profile: 'flash' (fast ~3-5s/step reactive loop) or 'pro' (deep planning + verification)
ARTEMIS_DEFAULT_PROFILE=flash
# UI hierarchy backend: 'auto' (Artemis Accessibility Helper HTTP server + UIAutomator2 fallback)
ARTEMIS_HIERARCHY_BACKEND=auto
ARTEMIS_HELPER_AUTO_INSTALL=true
ARTEMIS_KEEP_DEVICE_AWAKE=true
