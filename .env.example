# AgentDroid needs NO LLM keys. Your AI SDK app's model is the brain.
# Required for the server:
AGENTDROID_API_KEY=change-me-to-a-long-random-string

# Optional
AGENTDROID_PORT=8080
# AGENTDROID_CORS_ORIGIN=https://your-app.example.com
# AGENTDROID_TRUST_PROXY=false        # true only behind your own reverse proxy
# AGENTDROID_RATE_LIMIT_RPM=120
# AGENTDROID_ALLOW_PRIVATE_NETWORKS=false

# Device
REDROID_IMAGE=redroid/redroid:16.0.0_64only-latest
REDROID_ADB_PORT=5555
REDROID_WIDTH=1080
REDROID_HEIGHT=2400
REDROID_DPI=440
REDROID_FPS=60
REDROID_GPU_MODE=guest
