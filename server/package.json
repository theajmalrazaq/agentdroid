{
  "name": "@agentdroid/server",
  "version": "0.3.0",
  "description": "Centralized AgentDroid server: one HTTP API plus Vercel AI SDK tools for driving a Redroid Android device",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.18" },
  "bin": { "agentdroid-server": "src/cli.ts" },
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": { "ai": ">=4.0.0", "zod": ">=3.20.0" },
  "peerDependenciesMeta": { "ai": { "optional": true }, "zod": { "optional": true } },
  "devDependencies": { "@types/node": "^24.0.0", "ai": "^5.0.0", "typescript": "^5.6.0", "zod": "^3.25.0" }
}
